# Copy this file to .env and fill in what you need.
# Load it with: export $(grep -v '^#' .env | xargs)   (or use python-dotenv / direnv)

# Which backend main.py should use: "claude" or "local"
AGENT_BACKEND=claude

# --- Claude (frontier, hosted) -----------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Cheapest current model; see https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Open-source model, via any OpenAI-compatible endpoint --------------
# Works the same whether that endpoint is local or a hosted service --
# see README for details. Pick ONE set of values below (or your own).

# Option A: Ollama running locally (`brew install ollama`, `ollama serve`,
# `ollama pull llama3.2`)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=not-needed

# Option B: llama.cpp's built-in server -- uncomment:
# LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL=<model name as reported by the server>
# LOCAL_LLM_API_KEY=not-needed

# Option C: LM Studio's local server (MLX backend on Apple Silicon) --
# uncomment:
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=<model name as shown in LM Studio>
# LOCAL_LLM_API_KEY=not-needed

# Option D: a hosted API serving open-source models (Together AI, Groq,
# Fireworks, HF Inference Endpoints, etc.) -- uncomment and fill in what
# that provider gave you:
# LOCAL_LLM_BASE_URL=<their base URL, ending in /v1>
# LOCAL_LLM_MODEL=<their model name/id>
# LOCAL_LLM_API_KEY=<their API key/token>

# --- web_search tool (optional) ------------------------------------------
# Lets the agent look up current/real-time information instead of relying
# only on the model's training data. Works with zero setup via DuckDuckGo's
# keyless Instant Answer API (infoboxes/definitions only, not general web
# search). For real web search results, set a free-tier key (2,000
# queries/month) at https://api.search.brave.com/app/keys.
BRAVE_SEARCH_API_KEY=
